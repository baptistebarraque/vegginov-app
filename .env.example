# "development" (default) or "production". Production makes the session
# cookie Secure (HTTPS only) and refuses to start with dev-only settings: a
# DB password that is the default or shorter than 16 characters, or
# non-https CORS_ALLOWED_ORIGINS / FRONTEND_BASE_URL.
APP_ENV=development

# Postgres
POSTGRES_USER=veggie
# Dev default. On a server, generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Postgres only reads this when its data volume is first created: changing
# it later also needs `ALTER USER ... PASSWORD ...` inside the database.
POSTGRES_PASSWORD=veggie
POSTGRES_DB=veggie_app
POSTGRES_PORT=5432
# Interface the published ports listen on. 127.0.0.1 = this machine only;
# 0.0.0.0 would expose them to the network. Keep 127.0.0.1 on a server.
POSTGRES_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1

# Backend
# Host is "localhost" here for running the backend locally (outside Docker)
# against the Dockerized Postgres. When the backend itself runs inside
# docker-compose, the "backend" service overrides this to use the "postgres"
# service name instead (Docker's internal network DNS).
DATABASE_URL=postgresql+psycopg://veggie:veggie@localhost:5432/veggie_app
BACKEND_PORT=8000
# Comma-separated browser origins allowed to call the API with cookies.
# In production: the public frontend URL, e.g. https://vegginov.example.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origin the password-reset link points at (the frontend). Set to the
# public URL once deployed.
FRONTEND_BASE_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Production only (docker-compose.prod.yml): the public domain Caddy serves
# and gets the HTTPS certificate for, e.g. vegginov.fr. Unset = localhost.
# SITE_ADDRESS=
